# Copy this file to config.env, fill in what you have, and restart the server.
# The portal works without any of these; each one switches on an extra feature.

# --- Bhashini: listen, speak and translate in Indian languages ---
# Register at https://bhashini.gov.in and generate a ULCA API key from your profile.
BHASHINI_USER_ID=
BHASHINI_API_KEY=
# Optional: use a different pipeline from the Bhashini / ULCA dashboard.
# BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd

# --- Sangi AI: Claude ---
# First run:  py -m pip install -r requirements.txt
# Keys: https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional overrides
# CLAUDE_MODEL=claude-opus-5
# CLAUDE_EFFORT=low

# --- Server ---
# HOST=0.0.0.0 lets phones on the same Wi-Fi open the portal. There is no login yet,
# so only do this on a network you trust.
# HOST=127.0.0.1
# PORT=8000
